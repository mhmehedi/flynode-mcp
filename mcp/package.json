{
  "name": "@flynode/mcp",
  "version": "0.1.0",
  "description": "FlyNode MCP server: lets Claude (or any MCP client) deploy a local project to FlyNode, watch the build and verify it is live.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "flynode-mcp": "dist/server.js",
    "flynode": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "test": "node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhmehedi/flynode-mcp.git",
    "directory": "mcp"
  },
  "homepage": "https://flynode.io",
  "publishConfig": {
    "access": "public"
  }
}
